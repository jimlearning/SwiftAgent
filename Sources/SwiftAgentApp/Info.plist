<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.swiftagent.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>SwiftAgent</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.5.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.swiftagent.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>swiftagent</string>
			</array>
		</dict>
	</array>
	<key>NSAppleEventsUsageDescription</key>
	<string>SwiftAgent uses Apple Events to integrate with macOS apps and capture window content for the Appshots feature.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>SwiftAgent needs screen recording access to capture the active window for the Appshots feature.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>SwiftAgent needs access to your Desktop to read screenshot files for the Appshots feature.</string>
	<key>NSApplicationSupportsSecureRestorableState</key>
	<true/>
</dict>
</plist>
